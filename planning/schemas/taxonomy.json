    {"class": "tax.1095", "doc_type": "tax_form", "examples": ["1095-A", "1095-B", "1095-C"], "key_fields": ["issuer", "tax_year", "covered_individuals", "months_covered", "marketplace_id"], "action": "keep_for_tax_year", "retention": "tax_year+7y", "retention_basis": "IRS", "sensitive": true, "junk": false},
    {"class": "tax.k1", "doc_type": "tax_form", "examples": ["Schedule K-1 (1065/1120-S/1041)"], "key_fields": ["entity", "ein", "tax_year", "partner_share_amounts"], "action": "keep_for_tax_year", "retention": "tax_year+7y; indefinitely while holding the interest", "retention_basis": "IRS", "sensitive": true, "junk": false},
